---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThoughtCard from "../components/ThoughtCard.astro";
import { moods, areas } from "../lib/taxonomy";
const philosopherOrder = ["socrates","epictetus","seneca","epicurus","confucius","laozi","kierkegaard","beauvoir","nietzsche"];
const philosophers = (await getCollection("philosophers")).filter((item) => item.data.published).sort((a,b) => philosopherOrder.indexOf(a.id) - philosopherOrder.indexOf(b.id));
const unsortedThoughts = (await getCollection("thoughts")).filter((item) => item.data.published);
const thoughts = Array.from({length:4},(_,round) => philosophers.flatMap((philosopher) => unsortedThoughts.filter((thought) => thought.data.philosopherId.id === philosopher.id)[round] || [])).flat();
const philosopherMap = new Map(philosophers.map((item) => [item.id, item]));
const homeJsonLd = { "@context":"https://schema.org", "@type":"ItemList", name:"悩みから探せる哲学", numberOfItems:moods.length, itemListElement:moods.map((mood,index) => ({ "@type":"ListItem", position:index+1, name:mood.name, url:new URL(`/moods/${mood.slug}/`,Astro.site).href })) };
---
<BaseLayout title="哲学レンズ｜いまの気持ちに、哲学の見方を" description="仕事、人間関係、恋愛、将来などの悩みを、哲学者の考えをもとにした短い言葉から静かに見つめ直す縦型フィード。">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
  <section class="discovery-hub" id="find" aria-labelledby="find-title">
    <h1 id="find-title">いま、何に悩んでいますか？</h1>
    <form class="problem-search" action="/search/" method="get">
      <label for="problem-input">悩みを言葉で入力</label>
      <div class="search-composer">
        <input id="problem-input" name="q" type="search" inputmode="search" placeholder="例：周りと比べてしまう、進路が不安" autocomplete="off" required />
        <button type="submit">哲学者を探す</button>
      </div>
      <p>短い言葉で大丈夫です。入力した悩みは保存・送信されません。</p>
    </form>
    <section class="choice-section" aria-labelledby="feeling-heading">
      <h2 id="feeling-heading">言葉にしづらければ、近い気持ちを選ぶ</h2>
      <div class="choice-grid mood-choices">{moods.map((mood) => <a href={`/moods/${mood.slug}/`}>{mood.name}</a>)}</div>
    </section>
    <section class="choice-section" aria-labelledby="situation-heading">
      <h2 id="situation-heading">悩んでいることを選ぶ</h2>
      <div class="choice-grid area-choices">{areas.map((area) => <a href={`/areas/${area.slug}/`}>{area.name}<span aria-hidden="true">→</span></a>)}</div>
    </section>
    <section class="choice-section" aria-labelledby="philosopher-heading">
      <h2 id="philosopher-heading">知っている哲学者から探す</h2>
      <div class="choice-grid philosopher-choices">{philosophers.map((item) => <a href={`/philosophers/${item.data.slug}/`}>{item.data.nameJa}</a>)}</div>
    </section>
    <a class="browse-link" href="#philosophy-feed">選ばずに言葉を眺める <span aria-hidden="true">↓</span></a>
  </section>
  <section class="feed-heading" id="philosophy-feed"><p class="overline">36の見方</p><h2>言葉を眺める</h2><p>気になった言葉は、保存してあとから読み返せます。</p></section>
  <section class="feed" role="feed" aria-label="哲学の考え" aria-busy="false">
    {thoughts.map((thought, index) => {
      const philosopher = philosopherMap.get(thought.data.philosopherId.id);
      return philosopher && <div data-moods={thought.data.moodIds.join(" ")}><ThoughtCard {thought} {philosopher} {index} total={thoughts.length} /></div>;
    })}
  </section>
  <script>
    const items = [...document.querySelectorAll<HTMLElement>("[data-feed-item]")];
    document.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "PageDown", "PageUp"].includes(event.key)) return;
      const visible = items.filter((item) => !item.parentElement?.hidden);
      const current = visible.findIndex((item) => item.getBoundingClientRect().top >= -8);
      const delta = event.key === "ArrowDown" || event.key === "PageDown" ? 1 : -1;
      const next = visible[Math.max(0, Math.min(visible.length - 1, current + delta))];
      if (next) { event.preventDefault(); next.scrollIntoView({ behavior: "smooth", block: "start" }); next.focus({ preventScroll: true }); }
    });
  </script>
</BaseLayout>
