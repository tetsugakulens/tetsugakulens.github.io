---
import "../styles/global.css";
interface Props { title: string; description: string; canonicalPath?: string; ogType?: "website" | "article"; }
const { title, description, canonicalPath = Astro.url.pathname, ogType = "website" } = Astro.props;
const site = Astro.site ?? new URL("https://example.invalid/");
const canonical = new URL(canonicalPath, site);
const ogImage = new URL("/og.png", site);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site.href}#website`, name: "哲学レンズ", url: site.href, inLanguage: "ja", potentialAction: { "@type": "SearchAction", target: `${new URL("/search/", site).href}?q={search_term_string}`, "query-input": "required name=search_term_string" } },
    { "@type": "WebPage", "@id": `${canonical.href}#webpage`, name: title, description, url: canonical.href, inLanguage: "ja", isPartOf: { "@id": `${site.href}#website` } },
  ],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11130f" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="哲学レンズ" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="哲学レンズ — 悩みに、別の見方を。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="哲学レンズ — 悩みに、別の見方を。" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href="/" aria-label="哲学レンズ ホーム">哲学レンズ</a>
      <nav aria-label="主なメニュー">
        <a href="/#find">悩みを探す</a><a href="/search/">文字で検索</a><a href="/saved/">保存</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <p>哲学レンズは、医療・心理相談・診断に代わるものではありません。</p>
      <nav aria-label="補助メニュー"><a href="/safety/">つらいときの案内</a><a href="/about/">出典と方針</a></nav>
      <small>© {new Date().getFullYear()} 哲学レンズ</small>
    </footer>
  </body>
</html>
