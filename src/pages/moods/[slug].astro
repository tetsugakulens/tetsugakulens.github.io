---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThoughtList from "../../components/ThoughtList.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { moods } from "../../lib/taxonomy";
export function getStaticPaths() { return moods.map((mood) => ({params:{slug:mood.slug},props:{mood}})); }
const { mood } = Astro.props;
const thoughts = (await getCollection("thoughts")).filter((x) => x.data.published && x.data.moodIds.includes(mood.id));
const philosophers = await getCollection("philosophers");
const relatedPhilosophers = [...new Set(thoughts.map((thought) => thought.data.philosopherId.id))].map((id) => philosophers.find((philosopher) => philosopher.id === id)).filter(Boolean);
const title = `${mood.name}ときに読む哲学｜哲学レンズ`;
const description = `${mood.name}と感じるとき、急いで答えを出さずに眺めたい哲学者の考えを集めました。`;
const jsonLd = { "@context":"https://schema.org", "@type":"ItemList", name:`${mood.name}ときに読む哲学`, numberOfItems:thoughts.length, itemListElement:thoughts.map((thought,index) => ({ "@type":"ListItem", position:index+1, name:thought.data.statement, url:new URL(`/thoughts/${thought.data.slug}/`,Astro.site).href })) };
---
<BaseLayout {title} {description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="content-shell wide" data-pagefind-body>
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">ホーム</a> / <span>今の気持ち</span> / <span>{mood.name}</span></nav>
    <p class="overline">今の気持ちから探す</p><h1>{mood.name}</h1>
    <p class="lead">この気持ちを急いで消さずに、見方をひとつ増やしてみる。</p>
    {("sensitive" in mood && mood.sensitive) && <SafetyNotice />}
    <section aria-labelledby="philosophers"><h2 id="philosophers">この気持ちを考える哲学者</h2><div class="related-philosophers">{relatedPhilosophers.map((philosopher) => philosopher && <a href={`/philosophers/${philosopher.data.slug}/`}><strong>{philosopher.data.nameJa}</strong><span>{philosopher.data.oneLine}</span></a>)}</div></section>
    <h2>この悩みに届く考え</h2>
    <ThoughtList {thoughts} {philosophers} />
  </div>
</BaseLayout>
