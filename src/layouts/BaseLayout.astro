---
import "../styles/global.css";
interface Props { title: string; description: string; canonicalPath?: string; }
const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11130f" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href="/" aria-label="哲学レンズ ホーム">哲学レンズ</a>
      <nav aria-label="主なメニュー">
        <a href="/#find">悩みから</a><a href="/search/">検索</a><a href="/saved/">保存</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <p>哲学レンズは、医療・心理相談・診断に代わるものではありません。</p>
      <nav aria-label="補助メニュー"><a href="/safety/">つらいときの案内</a><a href="/about/">出典と方針</a></nav>
      <small>© {new Date().getFullYear()} 哲学レンズ</small>
    </footer>
  </body>
</html>
