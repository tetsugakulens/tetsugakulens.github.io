---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThoughtList from "../../components/ThoughtList.astro";
export async function getStaticPaths() { const items = await getCollection("philosophers"); return items.filter((x) => x.data.published).map((philosopher) => ({ params: { slug: philosopher.data.slug }, props: { philosopher } })); }
const { philosopher } = Astro.props;
const thoughts = (await getCollection("thoughts")).filter((x) => x.data.published && x.data.philosopherId.id === philosopher.id);
const sources = await getCollection("sources");
const sourceMap = new Map(sources.map((x) => [x.id, x]));
const title = `${philosopher.data.nameJa}の哲学｜悩みに届く4つの考え｜哲学レンズ`;
const description = `${philosopher.data.oneLine} ${philosopher.data.story}`.slice(0, 150);
const nameLength = [...philosopher.data.nameJa].length;
const nameSize = nameLength >= 7 ? "name-long" : nameLength >= 5 ? "name-medium" : "name-short";
const jsonLd = { "@context":"https://schema.org", "@type":"Article", headline:`${philosopher.data.nameJa}の哲学`, description, about:{"@type":"Person",name:philosopher.data.nameJa,alternateName:philosopher.data.nameOriginal}, mainEntityOfPage:new URL(Astro.url.pathname,Astro.site).href };
---
<BaseLayout {title} {description} ogType="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="content-shell wide" data-pagefind-body>
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">ホーム</a> / <span>哲学者</span> / <span>{philosopher.data.nameJa}</span></nav>
    <p class="overline">{philosopher.data.era} · {philosopher.data.region}</p>
    <h1 class={`name-display ${nameSize}`}>{philosopher.data.nameJa}</h1><p class="original">{philosopher.data.nameOriginal}</p>
    <p class="lead">{philosopher.data.oneLine}</p><p>{philosopher.data.story}</p>
    <blockquote>{philosopher.data.centralQuestion}</blockquote>
    <section><h2>{philosopher.data.nameJa}から届く4つの見方</h2><ThoughtList {thoughts} philosophers={[philosopher]} /></section>
    <section><h2>参照した資料</h2><ul>{philosopher.data.sourceRefs.map((ref: {id:string}) => { const s = sourceMap.get(ref.id); return s && <li><a href={s.data.url} rel="external">{s.data.work} — {s.data.section}</a><p>{s.data.usageNote}</p></li>; })}</ul></section>
  </article>
</BaseLayout>
