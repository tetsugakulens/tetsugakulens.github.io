---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThoughtCard from "../components/ThoughtCard.astro";
import { moods, areas } from "../lib/taxonomy";
const philosopherOrder = ["socrates","epictetus","seneca","epicurus","confucius","laozi","kierkegaard","beauvoir","nietzsche"];
const philosophers = (await getCollection("philosophers")).filter((item) => item.data.published).sort((a,b) => philosopherOrder.indexOf(a.id) - philosopherOrder.indexOf(b.id));
const unsortedThoughts = (await getCollection("thoughts")).filter((item) => item.data.published);
const thoughts = Array.from({length:4},(_,round) => philosophers.flatMap((philosopher) => unsortedThoughts.filter((thought) => thought.data.philosopherId.id === philosopher.id)[round] || [])).flat();
const philosopherMap = new Map(philosophers.map((item) => [item.id, item]));
const moodGuides = moods.map((mood) => ({
  ...mood,
  philosophers: philosophers.filter((philosopher) => unsortedThoughts.some((thought) => thought.data.philosopherId.id === philosopher.id && thought.data.moodIds.includes(mood.id))),
}));
---
<BaseLayout title="哲学レンズ｜いまの気持ちに、哲学の見方を" description="仕事、人間関係、恋愛、将来などの悩みを、哲学者の考えをもとにした短い言葉から静かに見つめ直す縦型フィード。">
  <section class="feed-intro" id="find" aria-labelledby="feed-title">
    <p>いまの気持ちに、別の見方を。</p>
    <h1 id="feed-title">考えを探す</h1>
    <div class="filter-row" aria-label="今の気持ち">
      <button class="filter-chip active" type="button" data-filter="all">すべて</button>
      {moods.map((mood) => <button class="filter-chip" type="button" data-filter={mood.id}>{mood.name}</button>)}
    </div>
    <details class="area-picker"><summary>生活領域から絞る</summary><div class="filter-row">{areas.map((area) => <a class="filter-chip" href={`/areas/${area.slug}/`}>{area.name}</a>)}</div></details>
    <details class="area-picker"><summary>哲学者に会う</summary><div class="filter-row">{philosophers.map((item) => <a class="filter-chip" href={`/philosophers/${item.data.slug}/`}>{item.data.nameJa}</a>)}</div></details>
    <div class="philosopher-guide" aria-live="polite">
      <div data-guide="all">
        <p><strong>気持ちを選ぶと、その悩みを考える哲学者が現れます。</strong></p>
        <p>まずは、いちばん近い言葉を一つ選んでください。</p>
      </div>
      {moodGuides.map((guide) => <div data-guide={guide.id} hidden>
        <p><strong>「{guide.name}」を考える哲学者</strong></p>
        <div class="guide-links">{guide.philosophers.map((item) => <a href={`/philosophers/${item.data.slug}/`}>{item.data.nameJa}<small>{item.data.oneLine}</small></a>)}</div>
      </div>)}
    </div>
    <a class="text-search-link" href="/search/">言葉で詳しく検索する <span aria-hidden="true">→</span></a>
    <p class="gesture-hint">下へスクロール <span aria-hidden="true">↓</span></p>
  </section>
  <section class="feed" role="feed" aria-label="哲学の考え" aria-busy="false">
    {thoughts.map((thought, index) => {
      const philosopher = philosopherMap.get(thought.data.philosopherId.id);
      return philosopher && <div data-moods={thought.data.moodIds.join(" ")}><ThoughtCard {thought} {philosopher} {index} total={thoughts.length} /></div>;
    })}
  </section>
  <p class="empty-state" hidden data-empty>その気持ちのカードは、これから増やしていきます。</p>
  <nav class="mood-directory" aria-label="気持ち別ページ">{moods.map((mood) => <a href={`/moods/${mood.slug}/`}>{mood.name}</a>)}</nav>
  <script>
    const items = [...document.querySelectorAll<HTMLElement>("[data-feed-item]")];
    document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        document.querySelectorAll("[data-filter]").forEach((item) => item.classList.toggle("active", item === button));
        document.querySelectorAll<HTMLElement>("[data-guide]").forEach((guide) => { guide.hidden = guide.dataset.guide !== filter; });
        let visible = 0;
        items.forEach((item) => {
          const wrapper = item.parentElement!;
          const show = filter === "all" || wrapper.dataset.moods?.split(" ").includes(filter || "");
          wrapper.hidden = !show;
          if (show) visible++;
        });
        document.querySelector<HTMLElement>("[data-empty]")!.hidden = visible > 0;
      });
    });
    document.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "PageDown", "PageUp"].includes(event.key)) return;
      const visible = items.filter((item) => !item.parentElement?.hidden);
      const current = visible.findIndex((item) => item.getBoundingClientRect().top >= -8);
      const delta = event.key === "ArrowDown" || event.key === "PageDown" ? 1 : -1;
      const next = visible[Math.max(0, Math.min(visible.length - 1, current + delta))];
      if (next) { event.preventDefault(); next.scrollIntoView({ behavior: "smooth", block: "start" }); next.focus({ preventScroll: true }); }
    });
  </script>
</BaseLayout>
